(defparameter *rows* 6)
(defparameter *cols* 7)
(defparameter *empty-cell* #\.)
(defparameter *players* (vector #\X #\O))
(defparameter *header* "=== Connect Four ===")
(defparameter *rules* "Get four of your pieces in a row to win. Columns are numbered 1-7.")
(defparameter *space-chars* (mapcar #'code-char '(9 10 11 12 13 32)))

(defun make-board ()
    (make-array (list *rows* *cols*) :initial-element *empty-cell*))

(defun lowest-empty-row (board column)
    (dotimes (row *rows* -1)
        (when (char= (aref board row column) *empty-cell*)
            (return row))))

(defun run-matches (board player start-row start-column row-step column-step)
    (dotimes (step 4)
        (let ((row (+ start-row (* step row-step)))
                (column (+ start-column (* step column-step))))
            (when (or (< row 0) (>= row *rows*) (< column 0) (>= column *cols*))
                (return-from run-matches nil))
            (unless (char= (aref board row column) player)
                (return-from run-matches nil))))
    t)

(defun has-four (board player)
    (dotimes (row *rows*)
        (dotimes (column *cols*)
            (when (or (run-matches board player row column 0 1)
                        (run-matches board player row column 1 0)
                        (run-matches board player row column 1 1)
                        (run-matches board player row column 1 -1))
                (return-from has-four t))))
    nil)

(defun border ()
    (concatenate 'string "+" (make-string (1- (* *cols* 2)) :initial-element #\-) "+"))

(defun print-board (board)
    (format t " ~{~a~^ ~}~%" (loop for column from 1 to *cols* collect column))
    (format t "~a~%" (border))
    (loop for row from (1- *rows*) downto 0 do
        (format t "|~{~a~^ ~}|~%"
            (loop for column below *cols* collect (aref board row column))))
    (format t "~a~%" (border))
    (finish-output))

(defun is-whole-number (text)
    (let ((body
            (if (and (> (length text) 0)
                    (or (char= (char text 0) #\+)
                        (char= (char text 0) #\-)))
                (subseq text 1)
                text)))
        (and (> (length body) 0)
            (every (lambda (ch) (char<= #\0 ch #\9)) body))))

(defun parse-value (text)
    (let* ((body
                (if (and (> (length text) 0)
                        (or (char= (char text 0) #\+)
                            (char= (char text 0) #\-)))
                    (subseq text 1)
                    text))
            (value (parse-integer body)))
        (if (and (> (length text) 0) (char= (char text 0) #\-))
            (- value)
            value)))

(defun ask-column (board player)
    (loop
        (format t "Player ~a, choose a column (1-7): " player)
        (finish-output)
        (let ((line (read-line *standard-input* nil)))
            (when (null line)
                (format t "~%Input closed. Goodbye.~%")
                (return -1))
            (let ((token (string-trim *space-chars* line)))
                (cond
                    ((zerop (length token))
                        (format t "~%Invalid input: no column entered.~%"))
                    ((not (is-whole-number token))
                        (format t "~%Invalid input: \"~a\" is not a whole number.~%" token))
                    (t
                        (let ((value (parse-value token)))
                            (cond
                                ((or (< value 1) (> value *cols*))
                                    (format t "~%Invalid input: \"~a\" is out of range (1-7).~%"
                                        token))
                                ((< (lowest-empty-row board (1- value)) 0)
                                    (format t "~%Column ~a is full.~%" value))
                                (t
                                    (return (1- value)))))))))))

(defun play ()
    (let ((board (make-board))
            (player-index 0)
            (moves 0))
        (format t "~a~%" *header*)
        (format t "~a~%" *rules*)
        (format t "~%")
        (print-board board)
        (loop
            (let* ((player (aref *players* player-index))
                    (column (ask-column board player)))
                (when (< column 0)
                    (return))
                (let ((row (lowest-empty-row board column)))
                    (setf (aref board row column) player)
                    (setf moves (1+ moves))
                    (format t "~%")
                    (print-board board))
                (when (has-four board player)
                    (format t "Player ~a wins!~%" player)
                    (finish-output)
                    (return))
                (when (= moves (* *rows* *cols*))
                    (format t "It's a tie!~%")
                    (finish-output)
                    (return))
                (setf player-index (- 1 player-index))))))

(play)
