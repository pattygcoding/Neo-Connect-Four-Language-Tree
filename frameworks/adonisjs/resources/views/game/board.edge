<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Connect Four</title>
</head>
<body>
    <h1>Connect Four</h1>

    @if(board.winner)
        <p>Player {{ board.winner }} wins!</p>
    @elseif(board.isOver)
        <p>It's a tie!</p>
    @else
        <p>Player {{ board.currentPlayer }}, choose a column.</p>
    @end

    <table class="board">
        @each(row in board.rowsTopDown())
            <tr>
                @each(cell in row)
                    <td class="cell cell--{{ cell.toLowerCase() }}">{{ cell }}</td>
                @end
            </tr>
        @end
    </table>

    <form method="post" action="/move">
        @for(column = 1; column <= 7; column++)
            <button type="submit" name="column" value="{{ column }}"
                    {{ board.isOver ? 'disabled' : '' }}>{{ column }}</button>
        @end
    </form>

    <form method="post" action="/reset">
        <button type="submit">New game</button>
    </form>
</body>
</html>
