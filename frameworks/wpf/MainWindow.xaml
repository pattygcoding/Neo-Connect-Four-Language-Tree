<Window x:Class="ConnectFour.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect Four - WPF" Height="600" Width="540">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="StatusLabel" Grid.Row="0" FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,10" />

        <UniformGrid x:Name="BoardGrid" Grid.Row="1" Rows="6" Columns="7" />

        <UniformGrid Grid.Row="2" Rows="1" Columns="7" Margin="0,10,0,0">
            <Button Content="1" Tag="1" Click="OnColumnClicked" Margin="2" Padding="6" />
            <Button Content="2" Tag="2" Click="OnColumnClicked" Margin="2" Padding="6" />
            <Button Content="3" Tag="3" Click="OnColumnClicked" Margin="2" Padding="6" />
            <Button Content="4" Tag="4" Click="OnColumnClicked" Margin="2" Padding="6" />
            <Button Content="5" Tag="5" Click="OnColumnClicked" Margin="2" Padding="6" />
            <Button Content="6" Tag="6" Click="OnColumnClicked" Margin="2" Padding="6" />
            <Button Content="7" Tag="7" Click="OnColumnClicked" Margin="2" Padding="6" />
        </UniformGrid>

        <Button Grid.Row="3" Content="New game" Click="OnResetClicked" Margin="0,10,0,0" Padding="8" />
    </Grid>
</Window>
