<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ConnectFour.MainPage"
             Title="Connect Four">
    <VerticalStackLayout Padding="16" Spacing="12">
        <Label x:Name="StatusLabel" FontSize="18" />

        <Grid x:Name="BoardGrid" RowSpacing="2" ColumnSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="32" />
            </Grid.ColumnDefinitions>
        </Grid>

        <HorizontalStackLayout Spacing="4">
            <Button Text="1" Clicked="OnColumnClicked" />
            <Button Text="2" Clicked="OnColumnClicked" />
            <Button Text="3" Clicked="OnColumnClicked" />
            <Button Text="4" Clicked="OnColumnClicked" />
            <Button Text="5" Clicked="OnColumnClicked" />
            <Button Text="6" Clicked="OnColumnClicked" />
            <Button Text="7" Clicked="OnColumnClicked" />
        </HorizontalStackLayout>

        <Button Text="New game" Clicked="OnResetClicked" />
    </VerticalStackLayout>
</ContentPage>
