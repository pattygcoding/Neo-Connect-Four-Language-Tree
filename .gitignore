# Build output of the test suite: every compiled program and golden-run
# capture lives here, so nothing else in the tree is generated by a test run.
tests/build/

# --------------------------------------------------------------------------
# Python
# --------------------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
.venv/
venv/

# --------------------------------------------------------------------------
# .NET (C#, F#, VB.NET)
# --------------------------------------------------------------------------
languages/**/bin/
languages/**/obj/
*.user

# --------------------------------------------------------------------------
# JVM (Java, Kotlin, Scala, Clojure)
# --------------------------------------------------------------------------
*.class
*.jar
.bsp/
.scala-build/
.bloop/
.metals/
.cpcache/

# A wrapper jar is part of the project, not build output, so it stays trackable
# despite `*.jar` above (a wrapper is how a clone builds without Gradle or Maven
# installed, and ignoring it silently breaks exactly that).
!**/gradle/wrapper/gradle-wrapper.jar
!**/.mvn/wrapper/maven-wrapper.jar

# --------------------------------------------------------------------------
# Gradle (JavaFX, Jetpack Compose, Ktor, Quarkus, Spring Boot, Gradle)
# `.gradle/` is the project cache, `build/` the compiled tree, `.kotlin/` the
# Kotlin session directory: every build rewrites all three, so a committed copy
# only ever shows up as a change that is not a change.
# --------------------------------------------------------------------------
.gradle/
build/
.kotlin/

# --------------------------------------------------------------------------
# BEAM (Erlang, Elixir)
# --------------------------------------------------------------------------
*.beam
erl_crash.dump
_build/
deps/

# --------------------------------------------------------------------------
# Nim and Zig
# --------------------------------------------------------------------------
nimcache/
.zig-cache/
zig-out/

# --------------------------------------------------------------------------
# OCaml (ocamlopt writes these next to the source file)
# --------------------------------------------------------------------------
*.cmi
*.cmx
*.cmo
*.cmt
*.cmti
*.annot

# --------------------------------------------------------------------------
# Native compiler output (C, C++, COBOL, Rust, assembly)
# --------------------------------------------------------------------------
*.exe
*.dll
*.pdb
*.o
*.obj

# --------------------------------------------------------------------------
# Node (TypeScript)
# --------------------------------------------------------------------------
node_modules/
*.tsbuildinfo

# --------------------------------------------------------------------------
# Web frameworks (frameworks/): the build directories and caches a dev server
# writes - Next.js, Nuxt, Astro, SvelteKit, Angular, Remix, Vite, Turborepo.
# --------------------------------------------------------------------------
.next/
.nuxt/
.output/
.astro/
.svelte-kit/
.angular/
.cache/
.turbo/
.vercel/
.vite/
.parcel-cache/
coverage/

# --------------------------------------------------------------------------
# Dart and Flutter (frameworks/flutter)
# --------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies

# --------------------------------------------------------------------------
# Swift (Vapor, SwiftUI): SwiftPM's `.build/` and Xcode's DerivedData
# --------------------------------------------------------------------------
.build/
DerivedData/
*.xcuserstate

# --------------------------------------------------------------------------
# Showcase dashboard (Vue + Vite): the built site is the GitHub Pages artifact
# (built in CI, never committed), and the data it loads is generated from the
# repository by tools/generate_dashboard.py via `npm run data`.
# --------------------------------------------------------------------------
dist/
public/dashboard-data.js

# --------------------------------------------------------------------------
# Rust
# --------------------------------------------------------------------------
target/

# --------------------------------------------------------------------------
# Ruby on Rails (frameworks/)
# --------------------------------------------------------------------------
frameworks/**/log/
frameworks/**/tmp/
frameworks/**/storage/
frameworks/**/.bundle/
frameworks/**/vendor/bundle/
frameworks/**/app/assets/builds/
frameworks/**/*.pid
frameworks/**/config/master.key
frameworks/**/config/credentials/*.key

# .NET (frameworks/blazor)
frameworks/**/bin/
frameworks/**/obj/

# --------------------------------------------------------------------------
# Editors and OS cruft
# --------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
*.log
.DS_Store
Thumbs.db
desktop.ini

